---
import Base from "../layouts/Base.astro";
// Starter questions: the page shows three, picked at random on each visit (ask.js).
const suggestions = ["What has Judd built?", "Is Judd a good hire?", "What does Judd do for fun?", "What is Judd looking for?",
                     "How does Judd test his AI?", "What did Judd do at his internship?", "Why did Judd get into AI?", "What did Judd learn from building Coach?"];
---
<Base title="Ask Judd Bot" description="Talk to Judd Bot: ask about Judd Gurtman's work by voice or text. It answers from a public list of facts, cites its sources, and can take you to any page on the site.">
  <div class="ask-page">
    <h1 class="sr-only">Ask Judd Bot</h1>
    <div class="ask-bar container-page">
      <label class="ask-toggle"><input type="checkbox" id="voice"> Always speak answers</label>
    </div>

    <div class="ask-stage" id="stage" role="button" tabindex="0" aria-label="Talk to Judd Bot">
      <canvas id="orb" aria-hidden="true"></canvas>
      <div class="ask-status" id="status">ONLINE</div>
    </div>

    <section class="ask-log" id="log" aria-label="Conversation">
      <div class="ask-log-inner" id="turns">
        <div class="ask-intro" id="intro">
          <p class="ask-intro-title">Ask Judd Bot</p>
          <p>Tap the orb and ask out loud, or type below. It answers from everything on this site plus a <a href="https://github.com/juddg-commits/juddgurtman.com/blob/main/bot/facts.md">public list of facts</a> about Judd, cites its sources, and can take you to any page.</p>
        </div>
      </div>
    </section>

    <div class="ask-dock">
      <div class="ask-try" id="try">
        {suggestions.map((s, i) => <button type="button" hidden={i >= 3}>{s}</button>)}
      </div>
      <form id="form" autocomplete="off">
        <label class="sr-only" for="q">Your question</label>
        <input id="q" maxlength="500" placeholder="Ask anything about Judd">
        <button class="ask-icon ask-mic" id="mic" type="button" aria-label="Start a voice conversation" title="Talk">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3"/></svg>
        </button>
        <button class="ask-icon ask-send" id="send" type="submit" aria-label="Ask">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </button>
      </form>
      <p class="ask-hint" id="hint">Questions are logged so Judd can improve the bot. Voice works in Chrome, Edge and Safari.</p>
    </div>
    <div class="ask-toast" id="toast" role="status"></div>
    <div class="sr-only" aria-live="polite" id="live"></div>
  </div>
</Base>

<style is:global>
  /* A normal page: it scrolls like the rest of the site, and the question box sits under the conversation. */
  .ask-bar { display: flex; justify-content: flex-end; padding-top: 14px; }
  .ask-toggle { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--muted); cursor: pointer; user-select: none; }
  .ask-toggle input { appearance: none; width: 34px; height: 18px; border-radius: 9px; background: var(--line); position: relative; cursor: pointer; margin: 0; transition: background .2s; }
  .ask-toggle input::after { content: ""; position: absolute; top: 3px; left: 3px; width: 12px; height: 12px; border-radius: 50%; background: var(--muted); transition: transform .2s, background .2s; }
  .ask-toggle input:checked { background: var(--accent); }
  .ask-toggle input:checked::after { transform: translateX(16px); background: var(--surface); }

  .ask-stage { position: relative; height: min(50vh, 480px); cursor: pointer; transition: height .6s cubic-bezier(.2,.8,.2,1); }
  .ask-stage.small { height: min(26vh, 240px); }
  .ask-stage[aria-disabled="true"] { cursor: default; }
  /* The whole stage is the button; the ring goes around its label. */
  .ask-stage:focus-visible { outline: none; }
  .ask-stage:focus-visible .ask-status { color: var(--ink); outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 2px; }
  .ask-stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* The background hides the ring's ticks behind the label when the orb is small. */
  .ask-status { position: absolute; bottom: 4px; left: 50%; transform: translateX(-50%); white-space: nowrap; background: var(--bg);
                padding: 0 calc(8px - .32em) 0 8px; font: 500 11.5px var(--font-mono); letter-spacing: .32em; color: var(--muted); }

  .ask-log { padding: 8px 20px 0; }
  .ask-log-inner { max-width: 680px; margin: 0 auto; }
  .ask-intro { text-align: center; color: var(--muted); max-width: 520px; margin: 0 auto; }
  .ask-intro .ask-intro-title { font-size: 26px; font-weight: 600; margin: 0 0 6px; letter-spacing: -.01em; color: var(--ink); }
  .ask-intro p { margin: 0; font-size: 15.5px; }
  .ask-intro a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; }
  .ask-turn { margin: 22px 0; }
  .ask-q { color: var(--ink); font-weight: 500; }
  .ask-q::before { content: "You"; display: block; font: 500 11px var(--font-mono); letter-spacing: .2em; color: var(--muted); text-transform: uppercase; margin-bottom: 2px; }
  .ask-a { margin-top: 12px; padding-left: 14px; border-left: 2px solid var(--accent); }
  .ask-a::before { content: "Judd Bot"; display: block; font: 500 11px var(--font-mono); letter-spacing: .2em; color: var(--accent); text-transform: uppercase; margin-bottom: 2px; }
  .ask-a p { margin: 0; }
  .ask-sources { margin-top: 8px; display: flex; flex-wrap: wrap; gap: 4px 14px; font-size: 13px; }
  .ask-sources a { color: var(--accent); text-underline-offset: 3px; }
  .ask-go { margin-top: 10px; font: 500 12.5px var(--font-mono); color: var(--accent); }
  .ask-dots { display: inline-flex; gap: 5px; padding: 8px 0 4px; }
  .ask-dots i { width: 6px; height: 6px; border-radius: 50%; background: var(--muted); animation: ask-dot 1s infinite ease-in-out; }
  .ask-dots i:nth-child(2) { animation-delay: .15s; }
  .ask-dots i:nth-child(3) { animation-delay: .3s; }
  @keyframes ask-dot { 0%, 80%, 100% { opacity: .25; transform: none; } 40% { opacity: 1; transform: translateY(-3px); } }
  @media (prefers-reduced-motion: reduce) {
    .ask-dots i { animation: none; opacity: .6; }
    .ask-stage { transition: none; }
  }
  .ask-next { margin-top: 12px; display: flex; flex-wrap: wrap; gap: 6px; }
  .ask-next button { font-size: 13px; color: var(--text); background: var(--surface); border: 1px solid var(--line); border-radius: 4px; padding: 4px 10px; cursor: pointer; text-align: left; }
  .ask-next button:hover { border-color: var(--ink); color: var(--ink); }

  .ask-dock { padding: 12px 20px 0; }
  .ask-try { max-width: 680px; margin: 0 auto 12px; display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; }
  .ask-try button { font-size: 13.5px; color: var(--text); background: var(--surface); border: 1px solid var(--line); border-radius: 4px; padding: 6px 12px; cursor: pointer; }
  .ask-try button:hover { border-color: var(--ink); color: var(--ink); }
  /* The same box as the home page's Ask form: square-ish, ink border, ink button. */
  .ask-dock form { max-width: 680px; margin: 0 auto; display: flex; background: var(--surface);
                   border: 1px solid var(--ink); border-radius: 4px; overflow: hidden; }
  .ask-dock form:focus-within { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
  .ask-dock #q { flex: 1; min-width: 0; background: none; border: 0; outline: none; color: var(--ink); font-size: 16px; padding: 14px 12px 14px 16px; }
  .ask-dock #q::placeholder { color: var(--muted); }
  .ask-icon { width: 52px; border: 0; display: grid; place-items: center; cursor: pointer; flex: none; }
  .ask-icon:focus-visible { outline-offset: -5px; }
  .ask-mic { background: var(--surface); color: var(--accent); border-left: 1px solid var(--line); }
  .ask-mic:hover { background: var(--accent-soft); }
  .ask-mic.on { background: var(--accent); color: var(--surface); }
  .ask-mic.on:focus-visible { outline-color: var(--surface); }   /* the accent ring would vanish on the accent button */
  /* Listening: the button breathes, so you can tell it's hearing you even with the orb scrolled away. */
  .ask-mic.listening { animation: ask-listen 1.3s ease-in-out infinite; }
  @keyframes ask-listen { 0%, 100% { box-shadow: inset 0 0 0 0 transparent; } 50% { box-shadow: inset 0 0 0 4px var(--surface); } }
  @media (prefers-reduced-motion: reduce) { .ask-mic.listening { animation: none; box-shadow: inset 0 0 0 3px var(--surface); } }
  .ask-send { background: var(--ink); color: var(--bg); }
  .ask-send:hover { opacity: .9; }
  .ask-send:focus-visible { outline-color: var(--bg); }
  .ask-icon:disabled, .ask-dock #q:disabled { opacity: .4; cursor: default; }
  .ask-hint { max-width: 680px; margin: 8px auto 0; text-align: center; font-size: 12px; color: var(--muted); }
  /* Fixed, just under the sticky header, so it shows wherever the page is scrolled. */
  .ask-toast { position: fixed; z-index: 50; left: 50%; top: calc(4rem + 14px); transform: translateX(-50%); width: max-content; max-width: calc(100% - 32px); background: var(--ink);
               color: var(--bg); font-size: 14px; padding: 8px 14px; border-radius: 4px; opacity: 0; transition: opacity .3s; pointer-events: none; }
  .ask-toast.show { opacity: 1; }
  @media (max-width: 640px) {
    .ask-stage { height: min(40vh, 340px); }
    .ask-stage.small { height: 20vh; }
    .ask-dock { padding-left: 12px; padding-right: 12px; }
    .ask-icon { width: 46px; }
  }
</style>

<script>
  import { startAsk } from "../scripts/ask.js";
  startAsk();
</script>
