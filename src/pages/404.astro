---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found" description="This page doesn't exist on juddgurtman.com." noindex>
  <div class="container-page py-24">
    <p class="num mb-3 text-muted">404</p>
    <h1 class="mb-4 text-[36px] font-semibold tracking-[-0.025em]">That page doesn't exist.</h1>
    <p class="mb-6 max-w-[52ch] text-[18px]">It may have moved when the site was rebuilt.</p>
    <p class="flex flex-wrap gap-x-6 gap-y-2"><a href="/" class="link-accent">Go home →</a><a href="/work/" class="link-accent">See the work →</a><a href="/ask/" class="link-accent">Ask Judd Bot →</a></p>
  </div>
</Base>
