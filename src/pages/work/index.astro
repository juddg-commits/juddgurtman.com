---
import Base from "../../layouts/Base.astro";
import ProjectRow from "../../components/ProjectRow.astro";
import { aiProjects, dataProjects } from "../../data/projects";
---
<Base title="Work" description="Judd Gurtman's projects: AI systems built in public with measured results, data projects, and a game.">
  <div class="container-page">
    <header class="border-b border-line pb-10 pt-12 md:pt-16">
      <h1 class="mb-4 text-[36px] font-semibold tracking-[-0.025em] md:text-[44px]">Work</h1>
      <p class="max-w-[60ch] text-[18px] leading-relaxed">The Year of AI is one project at a time, shipped in public, each with a write-up of what broke. Every number below came from a measured run, and each case study says which one.</p>
    </header>

    <section class="pt-14" aria-labelledby="ai">
      <div class="section-head"><h2 id="ai">AI projects</h2></div>
      {aiProjects.map((p) => <ProjectRow project={p} />)}
    </section>

    <section class="pt-16" aria-labelledby="data">
      <div class="section-head"><h2 id="data">Data projects</h2></div>
      {dataProjects.map((p) => <ProjectRow project={p} />)}
    </section>

    <section class="pt-16" aria-labelledby="fun">
      <div class="section-head"><h2 id="fun">For fun</h2></div>
      <article class="grid gap-8 py-8 md:grid-cols-[1.1fr_1fr] md:items-center md:gap-12">
        <div class="grid gap-3">
          <img src="/images/clout-royale-hub.jpg" width="1000" height="586" loading="lazy" class="rounded border border-line"
               alt="Clout Royale home base: a pixel-art mansion with upgrade stations">
          <img src="/images/clout-royale-fight.jpg" width="1000" height="586" loading="lazy" class="rounded border border-line"
               alt="Clout Royale mission: a top-down arena fight against parody creator characters">
        </div>
        <div>
          <p class="mb-1 text-[14px] text-muted">TypeScript · Phaser 3</p>
          <h3 class="mb-3 text-[22px] font-semibold">Clout Royale</h3>
          <p class="mb-4">A satirical top-down arena game about the creator economy. You play a gym influencer defending your mansion from waves of parody creators. Eliminations earn clout, your Aura meter powers your abilities, and your Cringe meter slows you down when you overdo it.</p>
          <p class="flex flex-wrap gap-x-5 gap-y-1 text-[15px]">
            <a href="https://juddg-commits.github.io/clout-royale/" class="link-accent">Play it in your browser (keyboard needed) ↗</a>
            <a href="https://github.com/juddg-commits/clout-royale" class="text-muted no-underline hover:text-ink">Code ↗</a>
          </p>
          <p class="mt-3 text-[14px] text-muted">Desktop only: keyboard and mouse.</p>
        </div>
      </article>
    </section>
  </div>
</Base>
