---
// Site header: name on the left, the pages on the right. Phones get a Menu button.
const links = [
  { href: "/", label: "Home" },
  { href: "/ask/", label: "Ask Judd Bot" },
  { href: "/work/", label: "Work" },
  { href: "/experience/", label: "Experience" },
  { href: "/writing/", label: "Writing" },
  { href: "/about/", label: "About" },
  { href: "/resume/", label: "Resume" },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---
<header class="sticky top-0 z-40 border-b border-line bg-bg/90 backdrop-blur">
  <div class="container-page flex h-16 items-center justify-between">
    <a href="/" class="font-semibold text-ink no-underline">Judd Gurtman</a>
    <button type="button" id="menu-button" class="rounded px-2 py-1 text-[15px] font-medium text-ink md:hidden"
            aria-expanded="false" aria-controls="site-nav">Menu</button>
    <nav id="site-nav" aria-label="Main"
         class="absolute inset-x-0 top-16 hidden border-b border-line bg-bg md:static md:block md:border-0 md:bg-transparent">
      <ul class="container-page flex flex-col py-2 md:w-auto md:flex-row md:gap-7 md:p-0">
        {links.map(({ href, label }) => (
          <li>
            <a href={href} aria-current={isCurrent(href) ? "page" : undefined}
               class:list={[
                 "block py-3 text-[15px] no-underline md:py-0 md:text-[14.5px]",
                 isCurrent(href) ? "font-medium text-ink" : href === "/ask/" ? "font-medium text-accent hover:text-ink" : "text-muted hover:text-ink",
               ]}>{label}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script>
  const button = document.getElementById("menu-button")!;
  const nav = document.getElementById("site-nav")!;
  const setOpen = (open: boolean) => {
    button.setAttribute("aria-expanded", String(open));
    button.textContent = open ? "Close" : "Menu";
    nav.classList.toggle("hidden", !open);
  };
  button.addEventListener("click", () => setOpen(button.getAttribute("aria-expanded") !== "true"));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && button.getAttribute("aria-expanded") === "true") { setOpen(false); button.focus(); } });
</script>
