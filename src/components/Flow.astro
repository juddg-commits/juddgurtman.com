---
// How a system works, as numbered steps with who does each one (a model or plain code).
// A list, not a picture: it reads on a phone and to a screen reader.
interface Step { name: string; who: string; text: string }
interface Props { steps: Step[]; label: string }
const { steps, label } = Astro.props;
---
<ol class="my-6 grid gap-px overflow-hidden rounded-md border border-line bg-line" aria-label={label}>
  {steps.map((s, i) => (
    <li class="grid grid-cols-[2.25rem_1fr] gap-x-3 bg-surface px-4 py-3.5 md:grid-cols-[2.25rem_190px_1fr] md:gap-x-5">
      <span class="num pt-0.5 text-[13px] text-muted">{String(i + 1).padStart(2, "0")}</span>
      <div>
        <strong class="block font-semibold text-ink">{s.name}</strong>
        <span class="text-[13px] text-accent">{s.who}</span>
      </div>
      <p class="col-start-2 mt-1 text-[15px] md:col-start-3 md:mt-0">{s.text}</p>
    </li>
  ))}
</ol>
