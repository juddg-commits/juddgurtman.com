---
// Resume, LinkedIn, GitHub and email as one row of buttons. The resume button is the filled one;
// on the resume page it downloads the PDF instead of opening the page.
interface Props { resume?: "page" | "pdf"; class?: string }
const { resume = "page", class: cls } = Astro.props;
const EMAIL = "judd@juddgurtman.com";
const links = [
  resume === "pdf"
    ? { label: "Download PDF", href: "/judd-gurtman-resume.pdf", icon: "doc", primary: true, download: true }
    : { label: "Resume", href: "/resume/", icon: "doc", primary: true },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/judd-gurtman-208769235/", icon: "linkedin" },
  { label: "GitHub", href: "https://github.com/juddg-commits", icon: "github" },
  { label: "Email", href: `mailto:${EMAIL}`, icon: "mail", title: EMAIL },
];
---
<ul class:list={["flex flex-wrap gap-3", cls]} aria-label="Resume and contact">
  {links.map((l) => (
    <li>
      <a href={l.href} title={l.title} download={l.download}
         class:list={["inline-flex items-center gap-2 rounded border px-4 py-2.5 text-[15px] font-medium no-underline",
                      l.primary ? "border-ink bg-ink text-bg hover:opacity-90" : "border-line bg-surface text-ink hover:border-ink"]}>
        {l.icon === "doc" && <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg>}
        {l.icon === "linkedin" && <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.1c0-1.22-.02-2.78-1.7-2.78-1.7 0-1.96 1.33-1.96 2.7V21h-4z"/></svg>}
        {l.icon === "github" && <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.7 18.3 5 18.3 5c.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3"/></svg>}
        {l.icon === "mail" && <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>}
        {l.label}
      </a>
    </li>
  ))}
</ul>
